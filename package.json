{
  "name": "review-assistant-31",
  "productName": "复习小助手3.1",
  "version": "1.13.0",
  "description": "复习小助手 1.13.0 · 多皮肤与界面主题",
  "author": "yorkx",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "icon": "node scripts/make-icon.js",
    "start": "electron .",
    "build": "node scripts/make-icon.js && electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.yorkx.review31",
    "productName": "复习小助手3.1",
    "copyright": "Copyright © 2026 yorkx",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "materials.js",
      "app/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/pdfjs-dist/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "复习小助手1.13.0.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "复习小助手1.13.0",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "language": "2052"
    },
    "portable": {
      "artifactName": "复习小助手1.13.0-便携版.exe",
      "unpackDirName": "ReviewAssistant31"
    }
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "pdfjs-dist": "^3.11.174"
  }
}
